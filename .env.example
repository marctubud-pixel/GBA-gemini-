# Optional: override the local backend with a remote, read-only content API.
# Leave unset to read your local /api/content collection.
# VITE_CONTENT_URL=https://your-content-service.example/api/portfolio
# VITE_ values are public browser configuration. Never put secrets here.
# Server-side local storage can be moved by setting PORTFOLIO_DATA_DIR in
# the launch environment (not VITE_PORTFOLIO_DATA_DIR). See docs/local-admin.md.
